FROM node:22-slim
RUN apt-get update && apt-get install -y curl && curl -LO https://dl.k8s.io/release/v1.31.0/bin/linux/amd64/kubectl && mv kubectl /usr/local/bin/kubectl && chmod +x /usr/local/bin/kubectl && apt-get purge -y --auto-remove curl && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend/package*.json ./backend/
RUN cd backend && npm install --omit=dev
COPY backend/dist ./backend/dist
COPY backend/prisma ./backend/prisma
COPY backend/setup-kubeconfig.sh /setup-kubeconfig.sh
RUN chmod +x /setup-kubeconfig.sh
RUN cd backend && npx prisma generate
EXPOSE 4000
ENTRYPOINT ["/setup-kubeconfig.sh"]
CMD ["node", "backend/dist/index.js"]
