generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  password     String
  githubId     String?
  avatarUrl    String?
  role         String    @default("user")
  plan         String    @default("trial")
  planStatus   String    @default("trial")
  serviceLimit Int       @default(4)
  planStartedAt DateTime?
  planRenewsAt  DateTime?
  lastMeteredAt DateTime?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  projects Project[]
  meters   UsageMeter[]
  auditLogs AuditLog[]
  emailConfig EmailConfig?
  emailMessages EmailMessage[]
  emailAccounts EmailAccount[]
  emailTemplates EmailTemplate[]

  @@map("users")
}

model UsageMeter {
  id            String   @id @default(cuid())
  userId        String
  serviceType   String   @default("app")
  serviceId     String   @default("")
  serviceName   String   @default("")
  period        String @default("") // 'yyyy-MM'
  credits       Float    @default(0)
  running       Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serviceId, period])
  @@index([userId, period])
  @@map("usage_meters")
}

model Project {
  id                String   @id @default(cuid())
  userId            String
  name              String
  k8sNamespace      String   @unique
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("projects")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // e.g., 'project.create', 'app.deploy', 'env.update'
  resource    String   // e.g., 'project', 'app', 'database'
  resourceId  String?  // ID of the affected resource
  details     Json?    // Additional context (old/new values, metadata)
  ipAddress   String?
  userAgent   String?
  status      String   @default("success") // 'success' or 'failure'
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailConfig {
  id        String   @id @default(cuid())
  userId    String   @unique
  provider  String   @default("gmail")
  email     String
  password  String
  host      String   @default("smtp.gmail.com")
  port      Int      @default(587)
  secure    Boolean  @default(true)
  fromName  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_configs")
}

model EmailMessage {
  id        String   @id @default(cuid())
  userId    String
  direction String
  from      String
  to        String
  subject   String
  body      String
  html      String?
  read      Boolean  @default(false)
  folder    String   @default("inbox")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments EmailAttachment[]

  @@index([userId, folder])
  @@index([userId, direction])
  @@map("email_messages")
}

model EmailAccount {
  id         String   @id @default(cuid())
  userId     String
  email      String
  provider   String   @default("gmail") // gmail, outlook, custom
  imapHost   String
  imapPort   Int      @default(993)
  smtpHost   String
  smtpPort   Int      @default(587)
  username   String
  password   String   // encrypted
  fromName   String?
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId])
  @@map("email_accounts")
}

model EmailAttachment {
  id         String   @id @default(cuid())
  messageId  String?
  userId     String
  fileName   String
  fileSize   Int
  mimeType   String
  storageKey String   // MinIO object key
  createdAt  DateTime @default(now()) @map("created_at")

  message EmailMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([messageId])
  @@map("email_attachments")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  subject   String
  body      String
  html      String?
  variables Json?    // array of variable names
  isSystem  Boolean  @default(false) // pre-built templates
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_templates")
}
